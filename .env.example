# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# ─── YouTube Download Proxy (ytsave.to) ─────────────────────────────────
# Optional fallback when yt-dlp is blocked (IP ban / bot checks).
#
# How it works in this repo:
# - When USE_YTSAVE_PROXY is true AND YTSAVE_PHPSESSID is set, OpenShorts will
#   try ytsave.to first.
# - If ytsave is not configured or errors, it falls back to yt-dlp.
#
# Get PHPSESSID from your browser after opening https://ytsave.to (DevTools →
# Application/Storage → Cookies → PHPSESSID).
USE_YTSAVE_PROXY=false
YTSAVE_PHPSESSID=

# ─── LLM Provider Configuration ─────────────────────────────────────────────
# Choose provider: "gemini" (Gemini native API) or "openai_compatible" (OpenAI-style /v1/chat/completions)
# LLM_PROVIDER=gemini

# LLM API Key (used for both providers; falls back to GEMINI_API_KEY for backward compat)
# LLM_API_KEY=

# LLM Base URL:
#   - gemini: https://generativelanguage.googleapis.com (or a native-compatible proxy)
#   - openai_compatible: e.g. http://host.docker.internal:8045/v1 (Antigravity Tool, LiteLLM, OpenRouter)
# LLM_BASE_URL=

# LLM Model name:
#   - gemini: gemini-2.5-flash
#   - openai_compatible: gemini-3-flash (or any model your proxy supports)
# LLM_MODEL=gemini-2.5-flash

# ─── Gemini Native (legacy / backward-compatible) ────────────────────────────
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# GEMINI_MODEL=gemini-2.5-flash

# ─── Transcription Provider ───────────────────────────────────────────────
# Choose transcription backend: "local" (Faster-Whisper CPU) or "groq" (Groq Whisper API)
TRANSCRIPTION_PROVIDER=local

# Groq Whisper API (used when TRANSCRIPTION_PROVIDER=groq)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# Split audio into chunks if longer than this many seconds (Groq limit ~25MB audio)
TRANSCRIPTION_CHUNK_SECONDS=600
# When TRANSCRIPTION_STRICT=true, crash on provider error instead of falling back
TRANSCRIPTION_STRICT=false
