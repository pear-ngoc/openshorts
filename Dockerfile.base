FROM python:3.11-slim

WORKDIR /app

# =========================
# SYSTEM DEPENDENCIES
# =========================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    nodejs \
    fontconfig \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# =========================
# PYTHON VENV
# =========================
RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

# =========================
# USER
# =========================
RUN groupadd -r appuser && \
    useradd -r -g appuser -d /app -s /usr/sbin/nologin appuser

# =========================
# DIRECTORIES
# =========================
RUN mkdir -p \
    /app/models \
    /app/uploads \
    /app/output/thumbnails \
    /app/outputs \
    /app/temp \
    /app/clips \
    /tmp/matplotlib \
    /tmp/cache \
    /tmp/Ultralytics

# =========================
# OWNERSHIP
# Chown BEFORE pip install
# Avoid massive recursive chown later
# =========================
RUN chown -R appuser:appuser \
    /app \
    /tmp/matplotlib \
    /tmp/cache \
    /tmp/Ultralytics \
    /opt/venv

# =========================
# ENV
# =========================
ENV YOLO_MODEL_PATH=/app/models/yolov8n.pt
ENV MPLCONFIGDIR=/tmp/matplotlib
ENV XDG_CACHE_HOME=/tmp/cache
ENV ULTRALYTICS_CONFIG_DIR=/tmp/Ultralytics

# =========================
# INSTALL AS NON-ROOT
# =========================
USER appuser

RUN pip install --upgrade pip setuptools wheel

# =========================
# TORCH CPU ONLY
# =========================
RUN pip install \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# =========================
# AI / VIDEO DEPENDENCIES
# =========================
RUN pip install \
    ultralytics \
    opencv-contrib-python \
    mediapipe \
    faster-whisper \
    ctranslate2 \
    onnxruntime \
    numpy \
    scipy \
    matplotlib \
    pillow \
    av \
    yt-dlp \
    google-genai \
    openai \
    python-dotenv \
    fastapi \
    uvicorn \
    python-multipart \
    boto3 \
    requests

# =========================
# PRELOAD YOLO
# =========================
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"