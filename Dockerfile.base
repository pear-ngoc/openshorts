# ============================================================
# NVIDIA CUDA Base Image — GPU-Accelerated Video Processing
# Compatible with NVIDIA GeForce RTX 3060 via WSL 2
# ============================================================
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# =========================
# SYSTEM DEPENDENCIES
# =========================
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    fontconfig \
    build-essential \
    git \
    curl \
    wget \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

# =========================
# PYTHON VENV
# =========================
RUN python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

# CUDA environment variables (required for torch + ffmpeg hardware encoding)
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENV CUDA_HOME=/usr/local/cuda

# =========================
# USER
# =========================
RUN groupadd -r appuser && \
    useradd -r -g appuser -d /app -s /usr/sbin/nologin appuser

# =========================
# DIRECTORIES
# =========================
RUN mkdir -p \
    /app/models \
    /app/uploads \
    /app/output/thumbnails \
    /app/outputs \
    /app/temp \
    /app/clips \
    /tmp/matplotlib \
    /tmp/cache \
    /tmp/Ultralytics

# =========================
# OWNERSHIP
# Chown BEFORE pip install to avoid massive recursive chown later
# =========================
RUN chown -R appuser:appuser \
    /app \
    /tmp/matplotlib \
    /tmp/cache \
    /tmp/Ultralytics \
    /opt/venv

# =========================
# ENV
# =========================
ENV YOLO_MODEL_PATH=/app/models/yolov8n.pt
ENV MPLCONFIGDIR=/tmp/matplotlib
ENV XDG_CACHE_HOME=/tmp/cache
ENV ULTRALYTICS_CONFIG_DIR=/tmp/Ultralytics

# =========================
# INSTALL AS NON-ROOT
# =========================
USER appuser

RUN pip install --upgrade pip setuptools wheel

# =========================
# TORCH WITH CUDA 12.1 SUPPORT
# =========================
# Install CUDA-enabled PyTorch from the official NVIDIA/conda channel via pip.
# Using cu121 wheel index for maximum RTX 3060 compatibility on CUDA 12.x driver.
RUN pip install \
    torch==2.3.1 \
    torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cu121

# =========================
# AI / VIDEO DEPENDENCIES
# =========================
RUN pip install \
    ultralytics \
    opencv-contrib-python \
    mediapipe \
    faster-whisper \
    ctranslate2 \
    onnxruntime \
    numpy \
    scipy \
    matplotlib \
    pillow \
    av \
    yt-dlp \
    google-genai \
    openai \
    python-dotenv \
    fastapi \
    uvicorn \
    python-multipart \
    boto3 \
    requests

# =========================
# PRELOAD YOLO + WARM UP CUDA
# =========================
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
RUN python3 -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}'); torch.zeros(1).cuda() if torch.cuda.is_available() else None"
